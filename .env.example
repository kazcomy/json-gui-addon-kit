# debug-probe-hub Configuration
# Copy this file to .env and update with your settings

# debug-probe-hub server URL (REST API endpoint)
DEBUG_PROBE_HUB_URL=http://remoteprogrammer.local.lan:8080

# SSH connection to debug-probe-hub server (for GDB tunneling)
DEBUG_PROBE_HUB_SSH_HOST=remoteprogrammer.local.lan
DEBUG_PROBE_HUB_SSH_USER=kazcomy

# Default target device name
DEBUG_PROBE_HUB_TARGET=ch32v003

# Default probe ID (find available probes with: ./tool/debug-probe-hub-client/client.py list-probes)
DEBUG_PROBE_HUB_PROBE=4
